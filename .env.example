# Postgres (local dev: matches docker-compose.yml)
DATABASE_URL=postgres://scenes:scenes@localhost:5432/scenes

# better-auth (SECRET signs sessions — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional). Leave blank to run email/password only. When both are
# set, also set NEXT_PUBLIC_GOOGLE_ENABLED=true to show the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Facebook Login (optional, same pattern as Google above). App ID/secret come
# from Meta for Developers (see docs/deployment-runbook.md).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
NEXT_PUBLIC_FACEBOOK_ENABLED=false

# Sign in with Apple (optional, same pattern). APPLE_CLIENT_SECRET is not a
# static string — it's a signed JWT that expires (max 6 months) and must be
# regenerated periodically. See docs/deployment-runbook.md for how to
# generate/rotate it.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
NEXT_PUBLIC_APPLE_ENABLED=false

# Dev mode — feedback widget. Comma-separated emails allowed to see the in-app
# note widget (⌘I) and the /dev/notes triage view. Leave blank to disable.
DEV_FEEDBACK_EMAILS=

# Where /dev/posters writes admin-uploaded poster files. Unset locally — falls
# back to ./.data/posters. In prod this must point at a persistent volume (see
# docs/deployment-runbook.md) or uploads are lost on every redeploy.
POSTER_UPLOADS_DIR=

# Bearer token for /api/dev/notes — lets the plan-from-notes Claude Code skill
# read/update the dev-notes backlog over HTTPS instead of exposing Postgres.
# Leave blank to disable the route. Generate with: openssl rand -hex 32
DEV_NOTES_API_TOKEN=

# Amazon Associates (amazon.fr only — the tag is program/geo-specific).
# Leave blank to hide the "Lire la pièce sur Amazon" link on show pages.
AMAZON_ASSOCIATE_TAG=

# Email (managed — Resend)
RESEND_API_KEY=

# Ingestion sources (fill as partnerships land)
DATATOURISME_API_KEY=
FRANCEBILLET_FEED_URL=
TICKETMASTER_API_KEY=
